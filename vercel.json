{
  "functions": {
    "api/**/*.js": {
      "maxDuration": 15
    }
  },
  "rewrites": [
    { "source": "/produto/:slug", "destination": "/api/index?path=page/product&slug=:slug" },
    { "source": "/sitemap.xml", "destination": "/api/index?path=page/sitemap" },
    { "source": "/robots.txt", "destination": "/api/index?path=page/robots" },
    { "source": "/feed/google.xml", "destination": "/api/index?path=page/feed" },
    { "source": "/:file(google[a-zA-Z0-9]+\\.html)", "destination": "/api/index?path=page/gverify&file=:file" },
    {
      "source": "/api/:path*",
      "destination": "/api/index?path=:path*"
    }
  ],
  "crons": [
    {
      "path": "/api/cron/expire-orders",
      "schedule": "0 3 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
